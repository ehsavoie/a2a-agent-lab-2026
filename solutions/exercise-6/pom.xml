<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.devconf</groupId>
        <artifactId>a2a-lab-solutions</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>enterprise-agent-parent-solution</artifactId>
    <packaging>pom</packaging>
    <name>DevSphere Enterprise Agent — Parent Solution (WildFly + Jakarta A2A SDK)</name>
    <description>Solution: Multi-node enterprise exercise — JPA-backed task store + Kafka-replicated queue manager across two WildFly nodes</description>

    <properties>
        <a2a-jakarta.version>1.0.0.Final</a2a-jakarta.version>
        <version.wildfly>41.0.1.Final</version.wildfly>
        <version.wildfly.datasources>11.4.0.Final</version.wildfly.datasources>
        <version.wildfly.grpc>0.2.1.Final</version.wildfly.grpc>
        <version.wildfly-maven-plugin>5.1.3.Final</version.wildfly-maven-plugin>
        <jboss.home>${project.build.directory}/wildfly</jboss.home>
        <wildfly.maven.plugin.phase>none</wildfly.maven.plugin.phase>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>jakarta.platform</groupId>
                <artifactId>jakarta.jakartaee-bom</artifactId>
                <version>11.0.0</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.a2aproject.sdk</groupId>
                <artifactId>a2a-java-sdk-extras-bom</artifactId>
                <version>${a2a-sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.a2aproject.sdk</groupId>
                <artifactId>a2a-java-sdk-reference-bom</artifactId>
                <version>${a2a-sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.wildfly.a2a</groupId>
                <artifactId>a2a-jakarta-parent</artifactId>
                <version>${a2a-jakarta.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <modules>
        <module>node-a</module>
        <module>node-b</module>
        <module>client</module>
    </modules>
</project>
