<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.devconf</groupId>
        <artifactId>a2a-lab-solutions</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>solution-expense-agent-parent</artifactId>
    <packaging>pom</packaging>
    <name>DevSphere Expense &amp; Compliance — Solution Parent</name>
    <description>Multi-module solution: expense A2A agent + web client that calls it via the A2A Java SDK</description>

    <properties>
        <a2a-jakarta.version>1.0.0.Final</a2a-jakarta.version>
        <version.wildfly>41.0.1.Final</version.wildfly>
        <version.wildfly-maven-plugin>5.1.3.Final</version.wildfly-maven-plugin>
        <jboss.home>${project.build.directory}/wildfly</jboss.home>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Jakarta EE BOM — not provided by ancestors (Quarkus exercises use quarkus-bom) -->
            <dependency>
                <groupId>jakarta.platform</groupId>
                <artifactId>jakarta.jakartaee-bom</artifactId>
                <version>11.0.0</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- A2A Jakarta SDK BOM — manages org.wildfly.a2a artifact versions -->
            <dependency>
                <groupId>org.wildfly.a2a</groupId>
                <artifactId>a2a-jakarta-parent</artifactId>
                <version>${a2a-jakarta.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <modules>
        <module>expense-agent</module>
        <module>expense-client</module>
    </modules>
</project>
