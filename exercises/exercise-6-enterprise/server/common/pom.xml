<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.devconf</groupId>
        <artifactId>enterprise-server-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>enterprise-agent-common</artifactId>
    <packaging>war</packaging>
    <name>DevSphere Enterprise Agent — Shared WAR</name>
    <description>One agent WAR deployed on both enterprise WildFly nodes</description>

    <dependencies>
        <!-- Jakarta EE APIs — provided by WildFly -->
        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.ws.rs</groupId>
            <artifactId>jakarta.ws.rs-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!--
            Enables MicroProfile Config integration for a2a-java configuration.
            Bundled in the WAR so CDI discovers MicroProfileConfigProvider, which reads
            META-INF/microprofile-config.properties from the deployment classpath.
        -->
        <dependency>
            <groupId>org.a2aproject.sdk</groupId>
            <artifactId>a2a-java-sdk-microprofile-config</artifactId>
        </dependency>

        <!-- A2A Java SDK — server core (bundled in WAR) -->
        <dependency>
            <groupId>org.a2aproject.sdk</groupId>
            <artifactId>a2a-java-sdk-server-common</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>jakarta.enterprise</groupId>
                    <artifactId>jakarta.enterprise.cdi-api</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>jakarta.inject</groupId>
                    <artifactId>jakarta.inject-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- ============================================================ -->
        <!-- Enterprise features: JPA-backed stores + replicated queue    -->
        <!-- manager, enabling multi-node/load-balanced deployment.       -->
        <!-- ============================================================ -->
        <dependency>
            <!-- JPA-backed TaskStore (replaces InMemoryTaskStore once on the classpath) -->
            <groupId>org.a2aproject.sdk</groupId>
            <artifactId>a2a-java-extras-task-store-database-jpa</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>jakarta.enterprise</groupId>
                    <artifactId>jakarta.enterprise.cdi-api</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>jakarta.inject</groupId>
                    <artifactId>jakarta.inject-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <!-- JPA-backed PushNotificationConfigStore -->
            <groupId>org.a2aproject.sdk</groupId>
            <artifactId>a2a-java-extras-push-notification-config-store-database-jpa</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>jakarta.enterprise</groupId>
                    <artifactId>jakarta.enterprise.cdi-api</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>jakarta.inject</groupId>
                    <artifactId>jakarta.inject-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <!-- Replicated queue manager core -->
            <groupId>org.a2aproject.sdk</groupId>
            <artifactId>a2a-java-queue-manager-replicated-core</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>io.quarkus</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>io.quarkus.arc</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>io.quarkus.security</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <!-- MicroProfile Reactive Messaging (Kafka) replication strategy -->
            <groupId>org.a2aproject.sdk</groupId>
            <artifactId>a2a-java-queue-manager-replication-mp-reactive</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>io.quarkus</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>io.quarkus.arc</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>io.quarkus.security</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>

    <build>
        <finalName>ROOT</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>jsonrpc</id>
            <dependencies>
                <dependency>
                    <groupId>org.wildfly.a2a</groupId>
                    <artifactId>a2a-jakarta-jsonrpc</artifactId>
                </dependency>
            </dependencies>
        </profile>

        <profile>
            <id>grpc</id>
            <dependencies>
                <dependency>
                    <groupId>org.wildfly.a2a</groupId>
                    <artifactId>a2a-jakarta-grpc</artifactId>
                    <exclusions>
                        <exclusion>
                            <groupId>io.grpc</groupId>
                            <artifactId>*</artifactId>
                        </exclusion>
                        <exclusion>
                            <groupId>com.google.protobuf</groupId>
                            <artifactId>protobuf-java</artifactId>
                        </exclusion>
                    </exclusions>
                </dependency>
                <!-- gRPC needs JSONRPC to serve the AgentCard -->
                <dependency>
                    <groupId>org.wildfly.a2a</groupId>
                    <artifactId>a2a-jakarta-jsonrpc</artifactId>
                </dependency>
            </dependencies>
        </profile>

        <profile>
            <id>rest</id>
            <dependencies>
                <dependency>
                    <groupId>org.wildfly.a2a</groupId>
                    <artifactId>a2a-jakarta-rest</artifactId>
                </dependency>
                <dependency>
                    <groupId>org.wildfly.a2a</groupId>
                    <artifactId>a2a-jakarta-jsonrpc</artifactId>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
