<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.devconf</groupId>
        <artifactId>a2a-lab-exercises</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>enterprise-agent-parent</artifactId>
    <packaging>pom</packaging>
    <name>DevSphere Enterprise Agent — Parent (WildFly + Jakarta A2A SDK)</name>
    <description>Multi-node enterprise exercise: JPA-backed task store + Kafka-replicated queue manager across two WildFly nodes</description>

    <properties>
        <a2a-jakarta.version>1.0.0.Final</a2a-jakarta.version>
        <version.wildfly>41.0.1.Final</version.wildfly>
        <version.wildfly.datasources>11.4.0.Final</version.wildfly.datasources>
        <version.wildfly.grpc>0.2.1.Final</version.wildfly.grpc>
        <version.wildfly-maven-plugin>5.1.3.Final</version.wildfly-maven-plugin>
        <jboss.home>${project.build.directory}/wildfly</jboss.home>
        <!--
            Default build does not provision a WildFly server.
            Each profile (jsonrpc, grpc, rest) sets this to 'package'.
        -->
        <wildfly.maven.plugin.phase>none</wildfly.maven.plugin.phase>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>jakarta.platform</groupId>
                <artifactId>jakarta.jakartaee-bom</artifactId>
                <version>11.0.0</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!--
                Pin the A2A Java SDK to the lab version before importing a2a-jakarta-parent,
                which would otherwise pull in its own (older) a2a-java-sdk-bom transitively.
                First-declared BOM wins in Maven, so these locks must come first.
            -->
            <dependency>
                <groupId>org.a2aproject.sdk</groupId>
                <artifactId>a2a-java-sdk-extras-bom</artifactId>
                <version>${a2a-sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.a2aproject.sdk</groupId>
                <artifactId>a2a-java-sdk-reference-bom</artifactId>
                <version>${a2a-sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- A2A Jakarta SDK BOM — manages org.wildfly.a2a artifact versions -->
            <dependency>
                <groupId>org.wildfly.a2a</groupId>
                <artifactId>a2a-jakarta-parent</artifactId>
                <version>${a2a-jakarta.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-war-plugin</artifactId>
                    <version>3.4.0</version>
                    <configuration>
                        <failOnMissingWebXml>false</failOnMissingWebXml>
                    </configuration>
                </plugin>
                <!--
                    Default WildFly provisioning for node-a and node-b: PostgreSQL + Kafka.
                    The gRPC profile in each node overrides <configuration> to add the gRPC
                    feature-pack and stability-level; all other settings are inherited here.
                -->
                <plugin>
                    <groupId>org.wildfly.plugins</groupId>
                    <artifactId>wildfly-maven-plugin</artifactId>
                    <version>${version.wildfly-maven-plugin}</version>
                    <configuration>
                        <feature-packs>
                            <feature-pack>
                                <groupId>org.wildfly</groupId>
                                <artifactId>wildfly-galleon-pack</artifactId>
                                <version>${version.wildfly}</version>
                            </feature-pack>
                            <feature-pack>
                                <groupId>org.wildfly</groupId>
                                <artifactId>wildfly-datasources-galleon-pack</artifactId>
                                <version>${version.wildfly.datasources}</version>
                            </feature-pack>
                        </feature-packs>
                        <discover-provisioning-info>
                            <add-ons>
                                <add-on>wildfly-cli</add-on>
                                <add-on>postgresql:default</add-on>
                                <add-on>kafka</add-on>
                            </add-ons>
                        </discover-provisioning-info>
                        <jboss-home>${jboss.home}</jboss-home>
                        <name>ROOT.war</name>
                        <provisioning-dir>${jboss.home}</provisioning-dir>
                        <galleon-options>
                            <jboss-fork-embedded>true</jboss-fork-embedded>
                        </galleon-options>
                    </configuration>
                    <executions>
                        <execution>
                            <id>provisioning</id>
                            <goals>
                                <goal>package</goal>
                            </goals>
                            <phase>${wildfly.maven.plugin.phase}</phase>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <modules>
        <module>node-a</module>
        <module>node-b</module>
        <module>client</module>
    </modules>
</project>
