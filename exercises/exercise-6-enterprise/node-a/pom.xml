<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.devconf</groupId>
        <artifactId>enterprise-agent-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>enterprise-agent-node-a</artifactId>
    <packaging>war</packaging>
    <name>DevSphere Enterprise Agent — Node A (WildFly + Jakarta A2A SDK)</name>
    <description>Node A of the enterprise exercise: runs on port 8080 (offset 0), shares PostgreSQL and Kafka with Node B</description>

    <dependencies>
        <!-- Jakarta EE APIs — provided by WildFly -->
        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.ws.rs</groupId>
            <artifactId>jakarta.ws.rs-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!--
            Enables MicroProfile Config integration for a2a-java configuration.
            Bundled in the WAR so CDI discovers MicroProfileConfigProvider, which reads
            META-INF/microprofile-config.properties from the deployment classpath.
        -->
        <dependency>
            <groupId>org.a2aproject.sdk</groupId>
            <artifactId>a2a-java-sdk-microprofile-config</artifactId>
        </dependency>

        <!-- A2A Java SDK — server core (bundled in WAR) -->
        <dependency>
            <groupId>org.a2aproject.sdk</groupId>
            <artifactId>a2a-java-sdk-server-common</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>jakarta.enterprise</groupId>
                    <artifactId>jakarta.enterprise.cdi-api</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>jakarta.inject</groupId>
                    <artifactId>jakarta.inject-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- ============================================================ -->
        <!-- Enterprise features: JPA-backed stores + replicated queue    -->
        <!-- manager, enabling multi-node/load-balanced deployment.       -->
        <!-- ============================================================ -->
        <dependency>
            <!-- JPA-backed TaskStore (replaces InMemoryTaskStore once on the classpath) -->
            <groupId>org.a2aproject.sdk</groupId>
            <artifactId>a2a-java-extras-task-store-database-jpa</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>jakarta.enterprise</groupId>
                    <artifactId>jakarta.enterprise.cdi-api</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>jakarta.inject</groupId>
                    <artifactId>jakarta.inject-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <!-- JPA-backed PushNotificationConfigStore -->
            <groupId>org.a2aproject.sdk</groupId>
            <artifactId>a2a-java-extras-push-notification-config-store-database-jpa</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>jakarta.enterprise</groupId>
                    <artifactId>jakarta.enterprise.cdi-api</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>jakarta.inject</groupId>
                    <artifactId>jakarta.inject-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <!-- Replicated queue manager core -->
            <groupId>org.a2aproject.sdk</groupId>
            <artifactId>a2a-java-queue-manager-replicated-core</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>io.quarkus</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>io.quarkus.arc</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>io.quarkus.security</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <!-- MicroProfile Reactive Messaging (Kafka) replication strategy -->
            <groupId>org.a2aproject.sdk</groupId>
            <artifactId>a2a-java-queue-manager-replication-mp-reactive</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>io.quarkus</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>io.quarkus.arc</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>io.quarkus.security</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.wildfly.plugins</groupId>
                <artifactId>wildfly-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>provisioning</id>
                        <goals>
                            <goal>package</goal>
                        </goals>
                        <phase>${wildfly.maven.plugin.phase}</phase>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>jsonrpc</id>
            <properties>
                <wildfly.maven.plugin.phase>package</wildfly.maven.plugin.phase>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>org.wildfly.a2a</groupId>
                    <artifactId>a2a-jakarta-jsonrpc</artifactId>
                </dependency>
            </dependencies>
        </profile>

        <profile>
            <id>grpc</id>
            <properties>
                <wildfly.maven.plugin.phase>package</wildfly.maven.plugin.phase>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>org.wildfly.a2a</groupId>
                    <artifactId>a2a-jakarta-grpc</artifactId>
                    <exclusions>
                        <exclusion>
                            <groupId>io.grpc</groupId>
                            <artifactId>*</artifactId>
                        </exclusion>
                        <exclusion>
                            <groupId>com.google.protobuf</groupId>
                            <artifactId>protobuf-java</artifactId>
                        </exclusion>
                    </exclusions>
                </dependency>
                <!-- gRPC needs JSONRPC to serve the AgentCard -->
                <dependency>
                    <groupId>org.wildfly.a2a</groupId>
                    <artifactId>a2a-jakarta-jsonrpc</artifactId>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.wildfly.plugins</groupId>
                        <artifactId>wildfly-maven-plugin</artifactId>
                        <configuration>
                            <feature-packs>
                                <feature-pack>
                                    <groupId>org.wildfly</groupId>
                                    <artifactId>wildfly-galleon-pack</artifactId>
                                    <version>${version.wildfly}</version>
                                </feature-pack>
                                <feature-pack>
                                    <groupId>org.wildfly.grpc</groupId>
                                    <artifactId>wildfly-grpc-feature-pack</artifactId>
                                    <version>${version.wildfly.grpc}</version>
                                </feature-pack>
                                <feature-pack>
                                    <groupId>org.wildfly</groupId>
                                    <artifactId>wildfly-datasources-galleon-pack</artifactId>
                                    <version>${version.wildfly.datasources}</version>
                                </feature-pack>
                            </feature-packs>
                            <discover-provisioning-info>
                                <add-ons>
                                    <add-on>wildfly-cli</add-on>
                                    <add-on>grpc</add-on>
                                    <add-on>postgresql:default</add-on>
                                    <add-on>kafka</add-on>
                                </add-ons>
                            </discover-provisioning-info>
                            <galleon-options>
                                <jboss-fork-embedded>true</jboss-fork-embedded>
                                <stability-level>preview</stability-level>
                            </galleon-options>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>rest</id>
            <properties>
                <wildfly.maven.plugin.phase>package</wildfly.maven.plugin.phase>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>org.wildfly.a2a</groupId>
                    <artifactId>a2a-jakarta-rest</artifactId>
                </dependency>
                <dependency>
                    <groupId>org.wildfly.a2a</groupId>
                    <artifactId>a2a-jakarta-jsonrpc</artifactId>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
